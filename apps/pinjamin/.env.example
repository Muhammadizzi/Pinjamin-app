# Pinjamin - Env Example
# Copy ke .env.local untuk lokal, atau set di Vercel Dashboard

# ── Auth admin (WAJIB di production) ──────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Kredensial bootstrap (opsional).
# Tanpa file data/admin.json dan tanpa baris di tabel admins:
#   development → username adminsystem / password admin123
#   production  → set ADMIN_PASSWORD (min 8) agar ter-hash saat login pertama
ADMIN_USERNAME=adminsystem
ADMIN_NAME=Administrator
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# ── Supabase (data & storage foto aset) ───────────────────────
# Dapatkan dari https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...
# WAJIB untuk app/api/data/**, /api/upload, dan auth admin via tabel admins.
# Server-only — JANGAN pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE=eyJhbGciOi...service_role...

# Kompatibel dengan shelf .env (opsional)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_PUBLIC=eyJ...

# Opsional: folder persistensi file (admin.json, store.json, tickets.json)
# PINJAMIN_DATA_DIR=/var/lib/pinjamin

# Opsional
NEXT_PUBLIC_APP_URL=http://localhost:5003
