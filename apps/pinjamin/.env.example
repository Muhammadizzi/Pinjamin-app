# Pinjamin - Env Example
# Copy to .env.local untuk lokal, atau set di Vercel Dashboard

# Supabase (Production - data & storage foto aset)
# Dapatkan dari https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...
# WAJIB untuk app/api/data/** & /api/upload (bypass RLS) - server-only,
# JANGAN pernah pakai prefix NEXT_PUBLIC_ atau expose ke client.
SUPABASE_SERVICE_ROLE=eyJhbGciOi...service_role...

# Kompatibel dengan shelf .env (opsional)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_PUBLIC=eyJ...
SUPABASE_SERVICE_ROLE=eyJ...

# Auth (untuk JWT pinjamin) - WAJIB di-set ke nilai random & rahasia di
# production, generate dengan: openssl rand -base64 32
# App akan gagal start (fail-fast) di production kalau ini kosong.
AUTH_SECRET=

# Opsional: Vercel URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Catatan ---
# Jika env kosong, Pinjamin otomatis fallback ke base64 (offline)
# jadi tetap bisa demo tanpa Supabase: upload akan disimpan di localStorage
# Untuk production, wajib isi NEXT_PUBLIC_SUPABASE_URL + ANON_KEY + buat bucket 'assets' public
