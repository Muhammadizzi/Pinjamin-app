# Pinjamin — Env Example
# Copy ke .env.local untuk lokal, atau set di Vercel Dashboard
# (Project → Settings → Environment Variables).

# ── Auth admin ────────────────────────────────────────────────
# WAJIB di production. Tanpa ini semua login gagal dengan 500.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Identitas admin bawaan (dipakai kalau tabel `admins` kosong).
ADMIN_USERNAME=adminsystem
ADMIN_NAME=Administrator

# Kredensial admin. Di PRODUCTION wajib salah satu dari:
#   a) baris di tabel `admins` (butuh SUPABASE_SERVICE_ROLE), atau
#   b) ADMIN_PASSWORD_HASH — bcrypt hash, cara paling aman, atau
#   c) ADMIN_PASSWORD — plaintext (min 8 karakter), di-hash saat runtime.
# Tanpa salah satunya, login production ditolak 503 (bukan jatuh ke
# kredensial demo adminsystem/admin123 yang hash-nya ada di source code).
# Buat hash: node -e "console.log(require('bcryptjs').hashSync('SandiAnda',12))"
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# ── Supabase (data, tiket, storage foto aset) ─────────────────
# Dapatkan dari https://supabase.com/dashboard → Project Settings → API.
# Tanpa ini app jalan mode file/localStorage — TIDAK BOLEH dipakai di Vercel
# (filesystem read-only + ephemeral, data hilang tiap deploy).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# WAJIB untuk app/api/data/**, /api/tickets/**, /api/upload, dan auth admin
# via tabel `admins`. Server-only — JANGAN pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE=eyJhbGciOi...service_role...

# Kompatibel dengan .env shelf (opsional)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_PUBLIC=eyJ...

# ── Opsional ──────────────────────────────────────────────────
# Folder persistensi mode file (admin.json, store.json, tickets.json).
# Hanya berguna di VPS/Docker dengan volume; tidak berlaku di Vercel.
# PINJAMIN_DATA_DIR=/var/lib/pinjamin

# Tampilkan blok "kredensial demo" di halaman login pada build production.
# Biarkan kosong kecuali memang deployment demo yang boleh diakses siapa saja.
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=1

NEXT_PUBLIC_APP_URL=http://localhost:5003
